# ─────────────────────────────────────────────────────────────
# SUSP — variables de entorno. Copiar a .env y completar.
# NUNCA commitear el .env real.
# ─────────────────────────────────────────────────────────────

# Puertos (bloque 557xx, elegido para no chocar con el resto de C:\Dev)
SUSP_API_PORT=55701
SUSP_DB_PORT=55702
SUSP_DASHBOARD_PORT=55703
SUSP_REFERENCE_PORT=55704

# Base de datos del motor
POSTGRES_USER=susp
POSTGRES_PASSWORD=susp_local_dev
POSTGRES_DB=susp
DATABASE_URL=postgresql://susp:susp_local_dev@localhost:55702/susp?schema=public

# Autenticación del motor
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio
# API key del primer tenant, se siembra con `npm run seed`
SUSP_BOOTSTRAP_API_KEY=susp_dev_bootstrap_key_cambiar

# Proveedor LLM del motor de agentes
# anthropic | deterministic
# `deterministic` no necesita API key y es el que usan los tests.
SUSP_LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
# Modelo para razonamiento/planificación de agentes
SUSP_LLM_MODEL_REASONING=claude-opus-5
# Modelo para generación masiva de contenido sintético (más barato)
SUSP_LLM_MODEL_CONTENT=claude-haiku-4-5

# Salvaguardas
# Si es true, el motor se niega a escribir contra apps marcadas como `production`.
SUSP_BLOCK_PRODUCTION_TARGETS=true
# Modo simulación: calcula y registra acciones sin llamar a los endpoints de escritura de USI.
SUSP_DRY_RUN=false

# Scheduler
SUSP_SCHEDULER_ENABLED=true
SUSP_SCHEDULER_POLL_MS=2000
SUSP_SCHEDULER_BATCH_SIZE=10

# Observabilidad
LOG_LEVEL=info
