# Imagen de producción del dashboard.
#
# El dashboard es una SPA: compila a estáticos y los sirve nginx. No necesita
# Node en runtime, así que la imagen final son unos pocos megas.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/engine/package.json apps/engine/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/reference-app/package.json apps/reference-app/
COPY packages/usi-spec/package.json packages/usi-spec/
COPY packages/usi-server/package.json packages/usi-server/
COPY packages/usi-conformance/package.json packages/usi-conformance/
COPY packages/sdk/package.json packages/sdk/
COPY packages/personas/package.json packages/personas/

RUN npm ci --no-audit --no-fund

COPY . .

# La URL de la API se hornea en el bundle: Vite resuelve import.meta.env en
# tiempo de compilación, no de ejecución. Si el despliegue cambia de dominio,
# hay que reconstruir la imagen.
ARG VITE_SUSP_API_URL=/api/v1
ENV VITE_SUSP_API_URL=$VITE_SUSP_API_URL

RUN cd apps/dashboard && npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 55703

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:55703/ >/dev/null || exit 1
