# Imagen de producción del motor.
#
# Multi-stage: la etapa de compilación arrastra el toolchain entero (nest, tsc,
# tipos) y la final se queda solo con lo que hace falta para correr. La
# diferencia no es cosmética — la imagen final pesa una fracción, y todo lo que
# no está no puede tener una vulnerabilidad.

# ─────────────────────────── 1. Dependencias ───────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

# Solo los manifiestos primero: mientras no cambien, Docker reutiliza la capa de
# instalación aunque haya cambiado todo el código.
COPY package.json package-lock.json ./
COPY apps/engine/package.json apps/engine/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/reference-app/package.json apps/reference-app/
COPY packages/usi-spec/package.json packages/usi-spec/
COPY packages/usi-server/package.json packages/usi-server/
COPY packages/usi-conformance/package.json packages/usi-conformance/
COPY packages/sdk/package.json packages/sdk/
COPY packages/personas/package.json packages/personas/

RUN npm ci --no-audit --no-fund

# ─────────────────────────── 2. Compilación ───────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN cd apps/engine \
 && npx prisma generate \
 && npm run build

# Se reinstala sin devDependencies: lo que va a la imagen final es solo runtime.
RUN npm ci --omit=dev --no-audit --no-fund \
 && cd apps/engine && npx prisma generate

# ─────────────────────────── 3. Runtime ───────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# `tini` como PID 1: sin él, Node no recibe SIGTERM y el contenedor se mata a la
# fuerza a los diez segundos, cortando trabajos a mitad de ejecución.
RUN apk add --no-cache tini

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/engine/dist ./apps/engine/dist
COPY --from=build /app/apps/engine/package.json ./apps/engine/
COPY --from=build /app/apps/engine/prisma ./apps/engine/prisma
COPY --from=build /app/apps/engine/prisma.config.ts ./apps/engine/
COPY --from=build /app/package.json ./

# Usuario sin privilegios: el proceso no tiene por qué correr como root.
USER node

WORKDIR /app/apps/engine
EXPOSE 55701

# El healthcheck usa el endpoint de liveness, que no toca la base: un problema
# de base tiene que verse en /health/ready, no matar el contenedor.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:55701/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
